@{
    ViewData["Title"] = "Local e Horários";
}

<style>

    .banner-local {
        background: linear-gradient(90deg,#1e7a3a,#2563eb);
        color:white;
        padding:60px 0;
    }

    .banner-local h1{
        font-size:42px;
        font-weight:600;
    }

    .card-unidade{
        background:white;
        border-radius:14px;
        padding:25px;
        box-shadow:0 4px 10px rgba(0,0,0,0.08);
    }

    .card-unidade h3{
        font-size:20px;
        margin-bottom:15px;
    }

    .info-box{
        background:#eaf2ff;
        border:1px solid #c6d7ff;
        border-radius:14px;
        padding:25px;
    }

    .icon{
        width:20px;
        margin-right:8px;
    }

    .card-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 12px 12px 0 0;
        margin-bottom: 15px;
    }

</style>


