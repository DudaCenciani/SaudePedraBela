@{
    @* Define o título da aba do navegador *@
    ViewData["Title"] = "Local e Horários";
}

<style>

    /* Banner do topo da página com gradiente verde-azul horizontal */
    .banner-local {
        background: linear-gradient(90deg, #1e7a3a, #2563eb);
        color: white;
        padding: 60px 0;
    }

        /* Título principal do banner */
        .banner-local h1 {
            font-size: 42px;
            font-weight: 600;
        }

    /* Card branco com sombra que envolve cada unidade de saúde */
    .card-unidade {
        background: white;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

        /* Título de cada unidade dentro do card */
        .card-unidade h3 {
            font-size: 20px;
            margin-bottom: 15px;
        }

    /* Caixa azul claro de informações importantes no rodapé da página */
    .info-box {
        background: #eaf2ff;
        border: 1px solid #c6d7ff;
        border-radius: 14px;
        padding: 25px;
    }

    /* Ícone inline com margem à direita (classe utilitária) */
    .icon {
        width: 20px;
        margin-right: 8px;
    }

    /* Imagem de capa da unidade com altura fixa e corte proporcional */
    .card-img {
        width: 100%;
        height: 180px;
        object-fit: cover; /* Recorta a imagem mantendo proporção */
        border-radius: 12px 12px 0 0; /* Arredonda apenas os cantos superiores */
        margin-bottom: 15px;
    }

</style>


@* ===== BANNER DO TOPO =====
   Cabeçalho com ícone decorativo e título da página *@
<div class="banner-local">
    <div class="container d-flex align-items-center">

        @* Ícone de localização com fundo semitransparente *@
        <div style="background:rgba(255,255,255,0.15); padding:18px; border-radius:12px; margin-right:20px">
            📍
        </div>

        <div>
            <h1>Local e Horários</h1>
            <p>Conheça os endereços das unidades de saúde e os horários de atendimento</p>
        </div>

    </div>
</div>


