@{
    ViewData["Title"] = "Escalas";
}

@* =====================================================
   ESCALAS - Info-Saúde Pedra Bela
   Seções: Header | Cards de Unidades | Aviso | Modal
   ===================================================== *@

<style>

    /* ---------- HEADER ---------- */
    .esc-header {
        background: linear-gradient(135deg, #1e7a3a 0%, #2563eb 100%);
        color: white;
        padding: 50px 40px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .esc-header-icon {
        background: rgba(255,255,255,0.15);
        border-radius: 16px;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .esc-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0 0 6px 0;
    }

    .esc-header p {
        margin: 0;
        opacity: 0.88;
        font-size: 1rem;
    }

    /* ---------- CONTAINER ---------- */
    .esc-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 50px 24px 60px;
    }

    /* ---------- TÍTULO DO ANO ---------- */
    .esc-ano {
        text-align: center;
        font-size: 1.6rem;
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 32px;
    }

    /* ---------- GRID DE CARDS ---------- */
    .esc-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }

    /* Card de cada unidade */
    .esc-card {
        background: white;
        border-radius: 16px;
        padding: 28px 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1.5px solid #e2e8f0;
        text-align: center;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

        .esc-card:hover {
            border-color: #1e7a3a;
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(30,122,58,0.12);
        }

    /* Ícone colorido no topo do card */
    .esc-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .esc-card h4 {
        font-size: 0.98rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0;
        line-height: 1.4;
    }

    /* Botão verde principal */
    .btn-acessar {
        background: #1e7a3a;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
    }

        .btn-acessar:hover {
            background: #15612e;
        }

        /* Botão cinza para cards secundários (PAPI, SAMU) */
        .btn-acessar.secundario {
            background: #64748b;
        }

            .btn-acessar.secundario:hover {
                background: #475569;
            }

    /* ---------- AVISO ---------- */
    .esc-aviso {
        background: #eaf2ff;
        border: 1.5px solid #c6d7ff;
        border-radius: 14px;
        padding: 20px 24px;
        font-size: 0.9rem;
        color: #1d4ed8;
    }

    /* ---------- MODAL DE ARQUIVOS ---------- */
    /* Overlay escuro */
    .arq-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

        .arq-overlay.ativo {
            display: flex;
        }

    /* Caixa do modal */
    .arq-box {
        background: white;
        border-radius: 18px;
        width: 100%;
        max-width: 700px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* Cabeçalho do modal */
    .arq-header {
        padding: 22px 28px 18px;
        border-bottom: 1px solid #e8ecf0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        background: white;
        border-radius: 18px 18px 0 0;
    }

        .arq-header h3 {
            font-size: 1.15rem;
            font-weight: 800;
            color: #1a1a2e;
            margin: 0;
        }

    .arq-close {
        background: #f1f5f9;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 1rem;
        cursor: pointer;
        color: #64748b;
        transition: background 0.2s;
    }

        .arq-close:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    /* Corpo do modal */
    .arq-body {
        padding: 20px 28px 28px;
    }

    /* Título do ano dentro do modal */
    .arq-ano-titulo {
        text-align: center;
        font-size: 1.2rem;
        font-weight: 800;
        color: #1a1a2e;
        margin: 16px 0 8px;
    }

    /* Título do mês dentro do modal */
    .arq-mes-titulo {
        font-size: 0.92rem;
        font-weight: 700;
        color: #1e7a3a;
        margin: 16px 0 8px;
        padding-bottom: 4px;
        border-bottom: 1.5px solid #e2e8f0;
    }

    /* Item de arquivo */
    .arq-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        margin-bottom: 8px;
        transition: border-color 0.2s;
    }

        .arq-item:hover {
            border-color: #1e7a3a;
        }

        .arq-item span {
            font-size: 0.88rem;
            color: #374151;
        }

    .arq-item-btns {
        display: flex;
        gap: 8px;
    }

    /* Botões visualizar/baixar */
    .btn-vis {
        background: #2563eb;
        color: white;
        padding: 6px 14px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-vis:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-baixar {
        background: #1e7a3a;
        color: white;
        padding: 6px 14px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-baixar:hover {
            background: #15612e;
            color: white;
        }

    /* Mensagem vazia */
    .arq-vazio {
        text-align: center;
        color: #94a3b8;
        padding: 30px 0;
        font-size: 0.95rem;
    }

    /* ---------- RESPONSIVO ---------- */
    @@media (max-width: 900px) {
        .esc-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .esc-grid {
            grid-template-columns: 1fr;
        }

        .esc-header {
            flex-direction: column;
            text-align: center;
        }
    }

</style>


@* ===== HEADER ===== *@
<div class="esc-header">
    <div class="esc-header-icon">📄</div>
    <div>
        <h1>Escalas dos Profissionais de Saúde</h1>
        <p>Consulte as escalas de atendimento das unidades de saúde</p>
    </div>
</div>


<div class="esc-container">

    @* Título do ano atual *@
    <div class="esc-ano">2026</div>

    @* ===== GRID DE CARDS DAS UNIDADES ===== *@
    <div class="esc-grid">

        @* --- Clínicos e Especialistas --- *@
        @* data-pasta é usado pelo JS para buscar os arquivos na pasta correta *@
        <div class="esc-card">
            <div class="esc-card-icon" style="background:#dbeafe; color:#2563eb;">🏥</div>
            <h4>Clínicos e Especialistas</h4>
            <button class="btn-acessar abrir-arquivos" data-pasta="clinicos">
                Acessar Arquivos
            </button>
        </div>

        @* --- Centro de Saúde --- *@
        <div class="esc-card">
            <div class="esc-card-icon" style="background:#dcfce7; color:#16a34a;">🏨</div>
            <h4>C.S Angelina Santana Schievenin</h4>
            <button class="btn-acessar abrir-arquivos" data-pasta="centro-saude">
                Acessar Arquivos
            </button>
        </div>

        @* --- UBS --- *@
        <div class="esc-card">
            <div class="esc-card-icon" style="background:#fce7f3; color:#db2777;">🏪</div>
            <h4>UBS Dr. Jorge Hirodi Orita</h4>
            <button class="btn-acessar abrir-arquivos" data-pasta="ubs">
                Acessar Arquivos
            </button>
        </div>

        @* --- Academia de Saúde (PAPI) --- *@
        <div class="esc-card">
            <div class="esc-card-icon" style="background:#ede9fe; color:#7c3aed;">🏃</div>
            <h4>Academia de Saúde (PAPI)</h4>
            <button class="btn-acessar secundario abrir-arquivos" data-pasta="papi">
                Acessar Arquivos
            </button>
        </div>

        @* --- SAMU --- *@
        <div class="esc-card">
            <div class="esc-card-icon" style="background:#fee2e2; color:#dc2626;">🚑</div>
            <h4>Base Descentralizada do SAMU 192</h4>
            <button class="btn-acessar secundario abrir-arquivos" data-pasta="samu">
                Acessar Arquivos
            </button>
        </div>

    </div>

    @* ===== AVISO ===== *@
    <div class="esc-aviso">
        <strong>* Arquivos serão publicados em breve.</strong>
    </div>

</div>


@* ===== MODAL DE ARQUIVOS ===== *@
@* Aberto pelo JS quando o usuário clica em "Acessar Arquivos" *@
<div id="modalArquivos" class="arq-overlay" onclick="fecharModalFora(event)">
    <div class="arq-box">

        <div class="arq-header">
            <h3>📁 Arquivos Disponíveis</h3>
            <button class="arq-close" onclick="fecharModal()">✕</button>
        </div>

        <div class="arq-body">
            @* Lista preenchida dinamicamente pelo JS *@
            <div id="listaArquivos"></div>
        </div>

    </div>
</div>


<script>

    // Converte número do mês para nome em português
    function nomeMes(mes) {
        const meses = [
            "", "Janeiro", "Fevereiro", "Março", "Abril",
            "Maio", "Junho", "Julho", "Agosto",
            "Setembro", "Outubro", "Novembro", "Dezembro"
        ];
        return meses[mes];
    }

    // Abre o modal com os arquivos da pasta clicada
    document.querySelectorAll(".abrir-arquivos").forEach(btn => {
        btn.addEventListener("click", function () {

            const pasta = this.dataset.pasta;
            const lista = document.getElementById("listaArquivos");

            // Mostra carregando enquanto busca
            lista.innerHTML = "<p style='text-align:center;color:#94a3b8;padding:20px 0'>Carregando...</p>";
            document.getElementById("modalArquivos").classList.add("ativo");
            document.body.style.overflow = "hidden";

            // Busca os arquivos da pasta no controller EscalasAdmin
            fetch("/EscalasAdmin/ListarArquivos?pasta=" + pasta)
                .then(res => res.json())
                .then(arquivos => {

                    lista.innerHTML = "";

                    // Se não tiver arquivos mostra mensagem
                    if (arquivos.length === 0) {
                        lista.innerHTML = "<div class='arq-vazio'>Nenhum arquivo encontrado.</div>";
                        return;
                    }

                    // Agrupa os arquivos por ano e mês
                    let agrupado = {};
                    arquivos.forEach(a => {
                        if (!agrupado[a.ano]) agrupado[a.ano] = {};
                        if (!agrupado[a.ano][a.mes]) agrupado[a.ano][a.mes] = [];
                        agrupado[a.ano][a.mes].push(a);
                    });

                    // Renderiza agrupado por ano > mês > arquivos
                    for (let ano in agrupado) {

                        lista.innerHTML += `<div class="arq-ano-titulo">${ano}</div><hr style="border-color:#e2e8f0">`;

                        for (let mes in agrupado[ano]) {

                            lista.innerHTML += `<div class="arq-mes-titulo">${nomeMes(parseInt(mes))}</div>`;

                            agrupado[ano][mes].forEach(a => {
                                lista.innerHTML += `
                                    <div class="arq-item">
                                        <span>📄 ${a.nome}</span>
                                        <div class="arq-item-btns">
                                            <a href="${a.caminho}" target="_blank" class="btn-vis">Visualizar</a>
                                            <a href="${a.caminho}" download class="btn-baixar">Baixar</a>
                                        </div>
                                    </div>
                                `;
                            });
                        }
                    }
                })
                .catch(() => {
                    lista.innerHTML = "<div class='arq-vazio' style='color:#dc2626'>Erro ao carregar arquivos.</div>";
                });
        });
    });

    // Fecha o modal pelo botão ✕
    function fecharModal() {
        document.getElementById("modalArquivos").classList.remove("ativo");
        document.body.style.overflow = "";
    }

    // Fecha clicando fora da caixa do modal
    function fecharModalFora(event) {
        if (event.target === document.getElementById("modalArquivos")) {
            fecharModal();
        }
    }

    // Fecha com a tecla ESC
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") fecharModal();
    });

</script>