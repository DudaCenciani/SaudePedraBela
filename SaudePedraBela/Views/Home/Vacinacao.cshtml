@* Define o model da View como uma coleção de campanhas de vacinação *@
@model IEnumerable<CampanhaVacinacao>

@* =====================================================
   VACINAÇÃO - Info-Saúde Pedra Bela
   Seções: Header | Campanhas | Calendário | Locais | Documentos
   ===================================================== *@

<style>

    /* ---------- HEADER ---------- */
    /* Cabeçalho com gradiente verde-azul e ícone à esquerda */
    .vac-header {
        background: linear-gradient(135deg, #1e7a3a 0%, #2563eb 100%);
        color: white;
        padding: 50px 40px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    /* Ícone decorativo no cabeçalho com fundo semitransparente */
    .vac-header-icon {
        background: rgba(255,255,255,0.15);
        border-radius: 16px;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    /* Título principal do cabeçalho */
    .vac-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0 0 6px 0;
    }

    /* Subtítulo do cabeçalho com leve transparência */
    .vac-header p {
        margin: 0;
        opacity: 0.88;
        font-size: 1rem;
    }

    /* ---------- CONTAINER GERAL ---------- */
    /* Limita a largura do conteúdo e centraliza na página */
    .vac-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 50px 24px 60px;
    }

    /* ---------- TÍTULO DE SEÇÃO ---------- */
    /* Cabeçalho reutilizável com ícone quadrado e título ao lado */
    .secao-titulo {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

        /* Ícone roxo padrão das seções */
        .secao-titulo .icone {
            background: #ede9fe;
            color: #7c3aed;
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

            /* Variação azul para a seção do calendário vacinal */
            .secao-titulo .icone.azul {
                background: #dbeafe;
                color: #2563eb;
            }

        /* Título de cada seção */
        .secao-titulo h2 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1a1a2e;
            margin: 0;
        }

    /* ---------- CARDS DE CAMPANHA ---------- */
    /* Grade de 3 colunas para os cards de campanhas */
    .campanhas-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 60px;
    }

    /* Card branco individual de cada campanha */
    .campanha-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1.5px solid #e2e8f0;
    }

        /* Linha do topo: título à esquerda e badge de status à direita */
        .campanha-card .card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 18px;
        }

        /* Nome da campanha */
        .campanha-card h5 {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

    /* Badge de status da campanha (cor varia conforme o status) */
    .status-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        white-space: nowrap; /* Impede quebra de linha no badge */
        flex-shrink: 0;
    }

    /* Badge verde: campanha em andamento */
    .status-verde {
        background: #dcfce7;
        color: #15803d;
    }

    /* Badge cinza: status padrão/desconhecido */
    .status-cinza {
        background: #f1f5f9;
        color: #64748b;
    }

    /* Badge azul: campanha disponível */
    .status-azul {
        background: #dbeafe;
        color: #1d4ed8;
    }

    /* Item de detalhe dentro do card (período, público-alvo) */
    .card-detalhe {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
    }

        /* Emoji/ícone do detalhe */
        .card-detalhe .det-icon {
            font-size: 0.9rem;
            margin-top: 2px;
        }

        /* Label do campo (ex: "Período", "Público-alvo") em cinza claro */
        .card-detalhe .det-label {
            font-size: 0.75rem;
            color: #94a3b8;
            margin-bottom: 2px;
        }

        /* Valor do campo em cor mais escura */
        .card-detalhe .det-valor {
            font-size: 0.88rem;
            color: #374151;
        }

    /* ---------- TABELA CALENDÁRIO ---------- */
    /* Tabela do calendário vacinal com bordas arredondadas e sombra */
    .cal-tabela {
        width: 100%;
        border-collapse: collapse;
        border-radius: 14px;
        overflow: hidden; /* Garante que o border-radius seja aplicado */
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        margin-bottom: 60px;
    }

        /* Cabeçalho da tabela com gradiente verde-azul */
        .cal-tabela thead tr {
            background: linear-gradient(90deg, #1e7a3a, #2563eb);
            color: white;
        }

        /* Células do cabeçalho */
        .cal-tabela thead th {
            padding: 16px 20px;
            font-size: 0.92rem;
            font-weight: 700;
            text-align: left;
        }

        /* Linhas do corpo da tabela com separador sutil */
        .cal-tabela tbody tr {
            border-bottom: 1px solid #f1f5f9;
            background: white;
            transition: background 0.15s;
        }

            /* Destaque suave ao passar o mouse na linha */
            .cal-tabela tbody tr:hover {
                background: #f8fafc;
            }

        /* Células do corpo da tabela */
        .cal-tabela tbody td {
            padding: 14px 20px;
            font-size: 0.9rem;
            color: #374151;
        }

            /* Coluna de idade em negrito para destaque visual */
            .cal-tabela tbody td:first-child {
                font-weight: 600;
                color: #1a1a2e;
                width: 200px;
            }

    /* ---------- LOCAIS + DOCUMENTOS ---------- */
    /* Grade de 2 colunas para os cards de locais e documentos necessários */
    .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 40px;
    }

    /* Card gradiente verde-azul com os locais de vacinação */
    .card-locais {
        background: linear-gradient(135deg, #1e7a3a, #2563eb);
        border-radius: 16px;
        padding: 28px;
        color: white;
    }

        /* Título do card de locais */
        .card-locais h4 {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 20px;
        }

    /* Item de cada local de vacinação */
    .local-item {
        margin-bottom: 14px;
    }

        /* Nome do local em negrito */
        .local-item strong {
            display: block;
            font-size: 0.92rem;
            margin-bottom: 2px;
        }

        /* Horário do local com leve transparência */
        .local-item span {
            font-size: 0.83rem;
            opacity: 0.85;
        }

    /* Card amarelo suave com os documentos necessários para vacinação */
    .card-docs-necessarios {
        background: #fefce8;
        border: 1.5px solid #fde68a;
        border-radius: 16px;
        padding: 28px;
    }

        /* Título do card de documentos em marrom */
        .card-docs-necessarios h4 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #92400e;
            margin-bottom: 18px;
        }

        /* Lista de documentos sem marcadores padrão */
        .card-docs-necessarios ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            /* Cada item da lista com separador inferior */
            .card-docs-necessarios ul li {
                font-size: 0.9rem;
                color: #78350f;
                padding: 6px 0;
                border-bottom: 1px solid #fde68a;
            }

                /* Remove separador do último item */
                .card-docs-necessarios ul li:last-child {
                    border-bottom: none;
                }

                /* Marcador personalizado laranja */
                .card-docs-necessarios ul li::before {
                    content: "• ";
                    color: #d97706;
                    font-weight: bold;
                }

    /* ---------- BOTÃO VER ANEXOS ---------- */
    /* Botão verde que abre o modal de documentos PDF */
    .btn-anexos {
        background: #1e7a3a;
        color: white;
        border: none;
        padding: 11px 22px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 50px;
        transition: background 0.2s;
    }

        .btn-anexos:hover {
            background: #15612e;
            color: white;
        }

    /* ---------- RESPONSIVO ---------- */
    /* Em telas médias: campanhas em 2 colunas e seção inferior em coluna única */
    @@media (max-width: 900px) {
        .campanhas-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .bottom-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Em telas pequenas: tudo em coluna única e cabeçalho centralizado */
    @@media (max-width: 600px) {
        .campanhas-grid {
            grid-template-columns: 1fr;
        }

        .vac-header {
            flex-direction: column;
            text-align: center;
        }
    }

</style>


@* ===== HEADER ===== *@
<div class="vac-header">
    <div class="vac-header-icon">💉</div>
    <div>
        <h1>Vacinação</h1>
        <p>Informações sobre campanhas e imunização no município</p>
    </div>
</div>


<div class="vac-container">

    @* ===== BOTÃO QUE ABRE O MODAL DE DOCUMENTOS PDF ===== *@
    <button class="btn-anexos"
            data-bs-toggle="modal"
            data-bs-target="#modalDocumentos">
        📄 Ver Anexos
    </button>


    @* ===== CAMPANHAS DE VACINAÇÃO ===== *@
    <div class="secao-titulo">
        <div class="icone">💉</div>
        <h2>Campanhas de Vacinação</h2>
    </div>

    <div class="campanhas-grid">

        @if (Model != null && Model.Any())
        {
            @* Itera cada campanha cadastrada no banco *@
            foreach (var campanha in Model)
            {
                @* Define a classe CSS do badge com base no valor do status (switch expression) *@
                var badgeClass = campanha.Status?.ToLower() switch
                {
                    "em andamento" => "status-verde",
                    "disponível" => "status-azul",
                    _ => "status-cinza" // Valor padrão para qualquer outro status
                };

                <div class="campanha-card">

                    <div class="card-top">
                        <h5>@campanha.Titulo</h5>
                        @* Badge colorido conforme o status da campanha *@
                        <span class="status-badge @badgeClass">@campanha.Status</span>
                    </div>

                    @* Período de início e fim da campanha *@
                    <div class="card-detalhe">
                        <span class="det-icon">📅</span>
                        <div>
                            <div class="det-label">Período</div>
                            <div class="det-valor">
                                @campanha.DataInicio.ToShortDateString()
                                até
                                @campanha.DataFim.ToShortDateString()
                            </div>
                        </div>
                    </div>

                    @* Público-alvo da campanha *@
                    <div class="card-detalhe">
                        <span class="det-icon">ℹ️</span>
                        <div>
                            <div class="det-label">Público-alvo</div>
                            <div class="det-valor">@campanha.PublicoAlvo</div>
                        </div>
                    </div>

                </div>
            }
        }
        else
        {
            @* Card placeholder exibido quando não há campanhas cadastradas *@
            <div class="campanha-card">
                <div class="card-top">
                    <h5>Nenhuma campanha cadastrada</h5>
                    <span class="status-badge status-cinza">Sem dados</span>
                </div>
                <div class="card-detalhe">
                    <span class="det-icon">📅</span>
                    <div>
                        <div class="det-label">Período</div>
                        <div class="det-valor">--</div>
                    </div>
                </div>
                <div class="card-detalhe">
                    <span class="det-icon">ℹ️</span>
                    <div>
                        <div class="det-label">Público-alvo</div>
                        <div class="det-valor">--</div>
                    </div>
                </div>
            </div>
        }

    </div>


    @* ===== CALENDÁRIO VACINAL =====
       Dados vêm do ViewBag.Calendario carregado pelo controller *@
    <div class="secao-titulo">
        <div class="icone azul">📅</div>
        <h2>Calendário Vacinal Infantil</h2>
    </div>

    <table class="cal-tabela">
        <thead>
            <tr>
                <th>Idade</th>
                <th>Vacinas</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.Calendario != null && ViewBag.Calendario.Count > 0)
            {
                @* Itera cada linha do calendário vacinal *@
                foreach (var item in ViewBag.Calendario)
                {
                    <tr>
                        <td>@item.Idade</td>
                        <td>@item.Vacinas</td>
                    </tr>
                }
            }
            else
            {
                @* Linha placeholder quando não há dados cadastrados *@
                <tr>
                    <td>--</td>
                    <td>--</td>
                </tr>
            }
        </tbody>
    </table>


    @* ===== LOCAIS + DOCUMENTOS NECESSÁRIOS ===== *@
    <div class="bottom-grid">

        @* Card gradiente com os locais de vacinação vindos do ViewBag.Locais *@
        <div class="card-locais">
            <h4>📍 Onde se Vacinar</h4>

            @if (ViewBag.Locais != null && ViewBag.Locais.Count > 0)
            {
                @* Itera cada local de vacinação cadastrado *@
                foreach (var local in ViewBag.Locais)
                {
                    <div class="local-item">
                        <strong>@local.Nome</strong>
                        <span>@local.Horario</span>
                    </div>
                }
            }
            else
            {
                @* Placeholder quando não há locais cadastrados *@
                <div class="local-item">
                    <strong>Local não cadastrado</strong>
                    <span>--</span>
                </div>
            }
        </div>

        @* Card amarelo com lista fixa de documentos necessários para vacinação *@
        <div class="card-docs-necessarios">
            <h4>Documentos Necessários</h4>
            <ul>
                <li>Cartão SUS ou CPF</li>
                <li>Carteira de vacinação (se possuir)</li>
                <li>Documento de identidade</li>
                <li>Comprovante de residência (para primeira dose)</li>
            </ul>
        </div>

    </div>

</div>


@* ===== MODAL DE DOCUMENTOS =====
   Exibe os PDFs anexados pelo admin com preview via iframe e botões de abrir/baixar *@
<div class="modal fade" id="modalDocumentos">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">📄 Documentos da Vacinação</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                @if (ViewBag.Documentos != null && ViewBag.Documentos.Count > 0)
                {
                    @* Itera cada documento PDF cadastrado pelo admin *@
                    foreach (var doc in ViewBag.Documentos)
                    {
                        <div class="mb-4 p-3 border rounded">

                            <h6 class="mb-2">📄 @doc.Titulo</h6>

                            @* Preview do PDF incorporado via iframe *@
                            <iframe src="@Url.Content(doc.Caminho)"
                                    width="100%"
                                    height="320"
                                    style="border:1px solid #ddd; border-radius:6px">
                            </iframe>

                            @* Botões para abrir em nova aba ou baixar o PDF *@
                            <div class="mt-2">
                                <a href="@Url.Content(doc.Caminho)"
                                   target="_blank"
                                   class="btn btn-primary btn-sm">
                                    Abrir
                                </a>
                                <a href="@Url.Content(doc.Caminho)"
                                   download
                                   class="btn btn-success btn-sm">
                                    Baixar
                                </a>
                            </div>

                        </div>
                    }
                }
                else
                {
                    @* Mensagem exibida quando não há documentos cadastrados *@
                    <p class="text-muted">Nenhum documento disponível.</p>
                }

            </div>

        </div>
    </div>
</div>