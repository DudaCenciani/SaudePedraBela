@model List<GestaoAno>


<style>
    @@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap');

    body {
        font-family: 'Nunito', sans-serif;
        background: #f4f6f9;
    }

    /* ===== HEADER ===== */
    .gestao-header {
        background: linear-gradient(135deg, #1e7a3a 0%, #2563eb 100%);
        color: white;
        padding: 60px 20px;
        text-align: center;
    }

    .gestao-header h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0 0 10px 0;
    }

    .gestao-header p {
        font-size: 1.1rem;
        opacity: 0.9;
        margin: 0;
    }

    /* ===== CONTAINER ===== */
    .gestao-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px 60px;
    }

    .gestao-container h2 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .gestao-container h2 .icon-box {
        background: #e8f0fe;
        color: #2563eb;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    /* ===== GRID DE ANOS ===== */
    .anos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 18px;
        margin-bottom: 50px;
    }

    .btn-ano {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        padding: 22px 15px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .btn-ano:hover {
        border-color: #1e7a3a;
        background: #f0faf4;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(30,122,58,0.15);
    }

    .btn-ano .ano-numero {
        font-size: 1.6rem;
        font-weight: 800;
        color: #1e7a3a;
        display: block;
    }

    .btn-ano .ano-label {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 5px;
        display: block;
    }

    .btn-ano .ano-count {
        display: inline-block;
        background: #e8f5ee;
        color: #1e7a3a;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        margin-top: 10px;
    }

    /* ===== CARD DIGISUS ===== */
    .digisus-card {
        background: linear-gradient(135deg, #1e3a5f, #2563eb);
        color: white;
        border-radius: 16px;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
        box-shadow: 0 8px 25px rgba(37,99,235,0.25);
    }

    .digisus-card .info h3 {
        font-size: 1.2rem;
        font-weight: 800;
        margin: 0 0 6px 0;
    }

    .digisus-card .info p {
        font-size: 0.9rem;
        opacity: 0.85;
        margin: 0;
    }

    .digisus-card a {
        background: white;
        color: #2563eb;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 10px;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 0.2s;
    }

    .digisus-card a:hover {
        transform: scale(1.04);
        color: #1e3a5f;
    }

    /* ===== MODAL ===== */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .modal-overlay.ativo {
        display: flex;
    }

    .modal-box {
        background: white;
        border-radius: 18px;
        width: 100%;
        max-width: 650px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from { transform: translateY(30px); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }

    .modal-header {
        padding: 24px 28px 20px;
        border-bottom: 1px solid #e8ecf0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #1a1a2e;
        margin: 0;
    }

    .modal-close {
        background: #f1f5f9;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 1.1rem;
        cursor: pointer;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

    .modal-close:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .modal-body {
        padding: 20px 28px 28px;
    }

    /* ===== ITEM PDF ===== */
    .pdf-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 18px;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 12px;
        transition: all 0.2s;
    }

    .pdf-item:hover {
        border-color: #1e7a3a;
        background: #f9fffe;
    }

    .pdf-item:last-child {
        margin-bottom: 0;
    }

    .pdf-item .pdf-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .pdf-item .pdf-icon {
        background: #ffe5e5;
        color: #dc2626;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .pdf-item .pdf-titulo {
        font-weight: 700;
        color: #1a1a2e;
        font-size: 0.95rem;
    }

    .pdf-item .pdf-sub {
        font-size: 0.8rem;
        color: #64748b;
    }

    .btn-ver {
        background: #1e7a3a;
        color: white;
        padding: 9px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        white-space: nowrap;
        transition: background 0.2s;
    }

    .btn-ver:hover {
        background: #15612e;
        color: white;
    }

    .empty-msg {
        text-align: center;
        color: #94a3b8;
        padding: 30px 0;
        font-size: 0.95rem;
    }

    @@media (max-width: 600px) {
        .anos-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .digisus-card {
            flex-direction: column;
            text-align: center;
        }
        .pdf-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }
</style>

<!-- HEADER -->
<div class="gestao-header">
    <h1>Gestão</h1>
    <p>Acesse relatórios e documentos da saúde</p>
</div>

<!-- CONTEÚDO -->
<div class="gestao-container">

    <h2>
        <span class="icon-box">📄</span>
        Relatórios de Gestão
    </h2>

    <!-- GRID DE ANOS -->
    @if (Model != null && Model.Any())
    {
        <div class="anos-grid">
            @foreach (var ano in Model.OrderByDescending(a => a.Ano))
            {
                <div class="btn-ano" onclick="abrirModal(@ano.Id)">
                    <span class="ano-numero">@ano.Ano</span>
                    <span class="ano-label">Documentos</span>
                    <span class="ano-count">@ano.Arquivos.Count arquivo(s)</span>
                </div>
            }
        </div>
    }
    else
    {
        <p style="color:#64748b;">Nenhum relatório disponível no momento.</p>
    }

    <!-- CARD DIGISUS -->
    <div class="digisus-card">
        <div class="info">
            <h3>🏛️ Portal DigiSUS</h3>
            <p>Acesse informações adicionais de transparência e relatórios no portal nacional do Ministério da Saúde.</p>
        </div>
        <a href="https://digisusgmp.saude.gov.br/v1.5/transparencia/downloads" target="_blank">
            Acessar Portal
        </a>
    </div>

</div>

<!-- MODAIS -->
@foreach (var ano in Model)
{
    <div id="modal_@ano.Id" class="modal-overlay" onclick="fecharModalFora(event, @ano.Id)">
        <div class="modal-box">
            <div class="modal-header">
                <h3>📁 Arquivos — @ano.Ano</h3>
                <button class="modal-close" onclick="fecharModal(@ano.Id)">✕</button>
            </div>
            <div class="modal-body">
                @if (ano.Arquivos != null && ano.Arquivos.Any())
                {
                    @foreach (var arq in ano.Arquivos)
                    {
                        <div class="pdf-item">
                            <div class="pdf-info">
                                <div class="pdf-icon">📄</div>
                                <div>
                                    <div class="pdf-titulo">@arq.Titulo</div>
                                    <div class="pdf-sub">@ano.Ano</div>
                                </div>
                            </div>
                            <a href="/pdf/gestao/@arq.Arquivo" target="_blank" class="btn-ver">
                                Ver Documento
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-msg">Nenhum arquivo disponível para este período.</div>
                }
            </div>
        </div>
    </div>
}

<script>
    function abrirModal(id) {
        document.getElementById("modal_" + id).classList.add("ativo");
        document.body.style.overflow = "hidden";
    }

    function fecharModal(id) {
        document.getElementById("modal_" + id).classList.remove("ativo");
        document.body.style.overflow = "";
    }

    function fecharModalFora(event, id) {
        if (event.target === document.getElementById("modal_" + id)) {
            fecharModal(id);
        }
    }

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
            document.querySelectorAll(".modal-overlay.ativo").forEach(function (el) {
                el.classList.remove("ativo");
                document.body.style.overflow = "";
            });
        }
    });
</script>