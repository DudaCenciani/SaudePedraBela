@model SaudePedraBela.Models.Categorias
@{
    ViewData["Title"] = "Excluir Categoria";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .admin-header {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: white;
        padding: 36px 40px;
        display: flex;
        align-items: center;
        gap: 20px;
        border-radius: 16px;
        margin-bottom: 32px;
    }

    .admin-header-icon {
        background: rgba(255,255,255,0.15);
        border-radius: 14px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .admin-header p {
        margin: 0;
        opacity: 0.85;
    }

    .delete-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1.5px solid #fecaca;
        max-width: 520px;
    }

    .aviso {
        background: #fee2e2;
        border-radius: 10px;
        padding: 14px 18px;
        color: #dc2626;
        font-weight: 600;
        font-size: 0.92rem;
        margin-bottom: 20px;
    }

    .detalhe-row {
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        gap: 16px;
    }

        .detalhe-row:last-of-type {
            border-bottom: none;
            margin-bottom: 20px;
        }

    .detalhe-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #64748b;
        width: 160px;
        flex-shrink: 0;
    }

    .detalhe-valor {
        font-size: 0.92rem;
        color: #1a1a2e;
    }

    .acoes {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

    .btn-del {
        background: #dc2626;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-del:hover {
            background: #b91c1c;
        }

    .btn-voltar {
        background: #f1f5f9;
        color: #374151;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.92rem;
    }
</style>

<div class="admin-header">
    <div class="admin-header-icon">🗑</div>
    <div>
        <h1>Excluir Categoria</h1>
        <p>Esta ação não pode ser desfeita</p>
    </div>
</div>

<div class="delete-card">
    <div class="aviso">⚠️ Tem certeza que deseja excluir esta categoria?</div>
    <div class="detalhe-row">
        <span class="detalhe-label">@Html.DisplayNameFor(m => m.NomeCategoria)</span>
        <span class="detalhe-valor">@Html.DisplayFor(m => m.NomeCategoria)</span>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="acoes">
            <button type="submit" class="btn-del">🗑 Confirmar Exclusão</button>
            <a asp-action="Index" class="btn-voltar">← Cancelar</a>
        </div>
    </form>
</div>