@model FarmaciaConfig

<h2>Configuração</h2>

<form asp-action="SalvarConfig" method="post">
    <input asp-for="Horario" placeholder="Horário" />
    <input asp-for="Local" placeholder="Local" />
    <button type="submit">Salvar</button>
</form>

<hr />

<h2>Cards</h2>

<a href="/AdminFarmacia/CriarCard">+ Novo Card</a>

@foreach (var card in ViewBag.Cards)
{
    <div style="margin-top:10px; padding:10px; border:1px solid #ccc;">
        <strong>@card.Titulo</strong>
        <p>@card.Descricao</p>
        <a href="@card.Link" target="_blank">Abrir</a>
    </div>
}