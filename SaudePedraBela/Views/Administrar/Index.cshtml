@{
    ViewData["Title"] = "Área Administrativa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <h2 class="text-center mb-5">Área Administrativa</h2>

    <div class="row text-center">

        <div class="col-md-4 mb-4">
            <a href="/Documentos" class="btn btn-primary btn-lg w-100 p-4">
                📄 Documentos
            </a>
        </div>

        <div class="col-md-4 mb-4">
            <a href="/Categorias" class="btn btn-success btn-lg w-100 p-4">
                🏷️ Categorias
            </a>
        </div>

        <div class="col-md-4 mb-4">
            <a href="/Usuarios" class="btn btn-warning btn-lg w-100 p-4">
                👤 Usuários
            </a>
        </div>

        <div class="col-md-4 mb-4">
            <a href="/EscalasAdmin" class="btn btn-warning btn-lg w-100 p-4">
                📅 Escalas
            </a>
        </div>

        <div class="col-md-4 mb-4">
            <a asp-controller="VacinacaoAdmin"
               asp-action="Index"
               class="btn btn-primary btn-lg w-100 p-4">
                💉 Vacinação
            </a>
        </div>

        <div class="col-md-4 mb-4">
            <a asp-controller="AdminFarmacia"
               asp-action="Index"
               class="btn btn-primary btn-lg w-100 p-4">
                💊 Farmácia
            </a>
        </div>

        <div class="col-md-4 mb-4">
            <a asp-controller="AdminGestao"
               asp-action="Index"
               class="btn btn-primary btn-lg w-100 p-4">
                 Gestão
            </a>
        </div>

    </div>

</div>