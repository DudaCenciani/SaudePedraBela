@* Define o model da View como uma lista de escalas *@
@model List<Escala>

@{
    @* Utiliza o layout administrativo *@
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @* Define o título da aba do navegador *@
    ViewData["Title"] = "Admin - Escalas";
}

<style>
    /* Cabeçalho da página com gradiente verde-azul e ícone à esquerda */
    .admin-header {
        background: linear-gradient(135deg, #1e7a3a, #2563eb);
        color: white;
        padding: 36px 40px;
        display: flex;
        align-items: center;
        gap: 20px;
        border-radius: 16px;
        margin-bottom: 32px;
    }

    /* Ícone decorativo no cabeçalho com fundo semitransparente */
    .admin-header-icon {
        background: rgba(255,255,255,0.15);
        border-radius: 14px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0; /* Impede encolhimento em telas menores */
    }

    /* Título principal do cabeçalho */
    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 4px;
    }

    /* Subtítulo do cabeçalho com leve transparência */
    .admin-header p {
        margin: 0;
        opacity: 0.85;
    }

    /* Card branco que agrupa cada seção da página (formulário e tabela) */
    .secao-card {
        background: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1.5px solid #e2e8f0;
        margin-bottom: 28px;
    }

        /* Título de cada seção dentro do card */
        .secao-card h3 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1a2e;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* Layout do formulário de upload em 4 colunas:
           unidade, mês, ano e arquivo ficam lado a lado */
    .form-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr) auto;
        gap: 12px;
        align-items: end; /* Alinha os campos pela base */
    }

    /* Botão verde de salvar o PDF */
    .btn-salvar {
        background: #1e7a3a;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
        white-space: nowrap; /* Evita que o texto do botão quebre linha */
    }

        .btn-salvar:hover {
            background: #15612e;
        }

    /* Tabela de arquivos enviados com largura total e sem espaçamento entre bordas */
    .arq-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
    }

        /* Cabeçalho da tabela com gradiente verde-azul */
        .arq-table thead tr {
            background: linear-gradient(90deg, #1e7a3a, #2563eb);
            color: white;
        }

        /* Células do cabeçalho */
        .arq-table thead th {
            padding: 12px 16px;
            font-size: 0.88rem;
            text-align: left;
        }

        /* Separador sutil entre as linhas do corpo da tabela */
        .arq-table tbody tr {
            border-bottom: 1px solid #f1f5f9;
        }

            /* Destaque suave ao passar o mouse sobre uma linha */
            .arq-table tbody tr:hover {
                background: #f8fafc;
            }

        /* Células do corpo da tabela */
        .arq-table tbody td {
            padding: 12px 16px;
            font-size: 0.88rem;
            color: #374151;
        }

    /* Botão azul claro para abrir o PDF em nova aba */
    .btn-abrir {
        background: #dbeafe;
        color: #2563eb;
        border: none;
        padding: 5px 12px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
    }

    /* Botão vermelho claro para excluir a escala */
    .btn-del {
        background: #fee2e2;
        color: #dc2626;
        border: none;
        padding: 5px 12px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>


@* Cabeçalho visual da página com ícone e título *@
<div class="admin-header">
    <div class="admin-header-icon">📄</div>
    <div>
        <h1>Escalas</h1>
        <p>Faça upload e gerencie as escalas dos profissionais de saúde</p>
    </div>
</div>

@* ===== SEÇÃO: FORMULÁRIO DE UPLOAD DE NOVA ESCALA ===== *@
<div class="secao-card">
    <h3>⬆️ Enviar Nova Escala</h3>

    @* Formulário com suporte a upload de arquivo (enctype multipart),
       enviado para a action Upload do controller EscalasAdmin *@
    <form asp-controller="EscalasAdmin" asp-action="Upload" method="post" enctype="multipart/form-data">
        <div class="form-row">

            @* Seleção da unidade de saúde à qual a escala pertence *@
            <div>
                <label class="form-label fw-semibold">Unidade</label>
                <select name="categoria" class="form-control">
                    <option value="clinicos">Clínicos e Especialistas</option>
                    <option value="centro-saude">C.S Angelina Santana Schievenin</option>
                    <option value="ubs">UBS Dr. Jorge Hirodi Orita</option>
                    <option value="papi">Academia de Saúde (PAPI)</option>
                    <option value="samu">Base Descentralizada do SAMU 192</option>
                </select>
            </div>

            @* Seleção do mês de referência da escala *@
            <div>
                <label class="form-label fw-semibold">Mês</label>
                <select name="mes" class="form-control">
                    <option value="1">Janeiro</option>
                    <option value="2">Fevereiro</option>
                    <option value="3">Março</option>
                    <option value="4">Abril</option>
                    <option value="5">Maio</option>
                    <option value="6">Junho</option>
                    <option value="7">Julho</option>
                    <option value="8">Agosto</option>
                    <option value="9">Setembro</option>
                    <option value="10">Outubro</option>
                    <option value="11">Novembro</option>
                    <option value="12">Dezembro</option>
                </select>
            </div>

            @* Campo numérico para o ano de referência da escala *@
            <div>
                <label class="form-label fw-semibold">Ano</label>
                <input type="number" name="ano" class="form-control" placeholder="Ex: 2026" />
            </div>

            @* Campo de upload do arquivo PDF da escala (obrigatório) *@
            <div>
                <label class="form-label fw-semibold">Arquivo PDF</label>
                <input type="file" name="arquivo" class="form-control" required />
            </div>

        </div>
        <div class="mt-3">
            <button type="submit" class="btn-salvar">💾 Salvar PDF</button>
        </div>
    </form>
</div>

@* ===== SEÇÃO: TABELA DE ARQUIVOS ENVIADOS ===== *@
<div class="secao-card">
    <h3>📁 Arquivos Enviados</h3>
    <table class="arq-table">
        <thead>
            <tr>
                <th>Unidade</th>
                <th>Arquivo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @* Loop que renderiza uma linha na tabela para cada escala cadastrada no Model *@
            @foreach (var item in Model)
            {
                <tr>
                    @* Exibe a categoria/unidade da escala *@
                    <td>@item.Categoria</td>

                    <td>
                        @* Link que abre o PDF da escala em nova aba *@
                        <a href="@item.CaminhoArquivo" target="_blank" class="btn-abrir">
                            📄 @item.NomeArquivo
                        </a>
                    </td>

                    <td>
                        @* Link gerado pelo Tag Helper que aciona a action Excluir
                           passando o ID da escala como parâmetro de rota *@
                        <a asp-action="Excluir" asp-route-id="@item.Id" class="btn-del">
                            🗑 Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>