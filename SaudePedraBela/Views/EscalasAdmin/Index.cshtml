@model List<Escala>

<h2>Gerenciar Escalas</h2>

<form asp-controller="EscalasAdmin"
      asp-action="Upload"
      method="post"
      enctype="multipart/form-data">
    <select name="categoria">

        <option value="clinicos">Clínicos e Especialistas</option>

        <option value="centro-saude">
            C.S Angelina Santana Schievenin
        </option>

        <option value="ubs">
            UBS Dr. Jorge Hirodi Orita
        </option>

        <option value="papi">
            Academia de Saúde (PAPI)
        </option>

        <option value="samu">
            Base Descentralizada do SAMU 192
        </option>

    </select>

    <select name="mes" class="form-control mb-2">

        <option value="1">Janeiro</option>
        <option value="2">Fevereiro</option>
        <option value="3">Março</option>
        <option value="4">Abril</option>
        <option value="5">Maio</option>
        <option value="6">Junho</option>
        <option value="7">Julho</option>
        <option value="8">Agosto</option>
        <option value="9">Setembro</option>
        <option value="10">Outubro</option>
        <option value="11">Novembro</option>
        <option value="12">Dezembro</option>

    </select>

    <input type="number" name="ano" class="form-control mb-2" placeholder="Ano" />

    <input type="file" name="arquivo" class="form-control mb-3" required />

    <button type="submit" class="btn btn-success">
        Salvar PDF
    </button>

</form>


<hr>

<h3>Arquivos enviados</h3>

<table class="table">

    <tr>
        <th>Categoria</th>
        <th>Arquivo</th>
        <th>Ação</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.Categoria</td>

            <td>
                <a href="@item.CaminhoArquivo" target="_blank">
                    @item.NomeArquivo
                </a>
            </td>

            <td>

                <a asp-action="Excluir" asp-route-id="@item.Id"
                   class="btn btn-danger btn-sm">
                    Excluir
                </a>

            </td>

        </tr>
    }

</table>