@model SaudePedraBela.Models.Documento
@{
    ViewData["Title"] = "Detalhes do Documento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .admin-header {
        background: linear-gradient(135deg, #1e7a3a, #2563eb);
        color: white;
        padding: 36px 40px;
        display: flex;
        align-items: center;
        gap: 20px;
        border-radius: 16px;
        margin-bottom: 32px;
    }

    .admin-header-icon {
        background: rgba(255,255,255,0.15);
        border-radius: 14px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .admin-header p {
        margin: 0;
        opacity: 0.85;
    }

    .detalhe-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1.5px solid #e2e8f0;
        max-width: 560px;
    }

    .detalhe-row {
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        gap: 16px;
    }

        .detalhe-row:last-of-type {
            border-bottom: none;
            margin-bottom: 20px;
        }

    .detalhe-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #64748b;
        width: 180px;
        flex-shrink: 0;
    }

    .detalhe-valor {
        font-size: 0.92rem;
        color: #1a1a2e;
        word-break: break-all;
    }

    .acoes {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

    .btn-editar {
        background: #fef3c7;
        color: #92400e;
        padding: 9px 20px;
        border-radius: 9px;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.88rem;
    }

    .btn-voltar {
        background: #f1f5f9;
        color: #374151;
        padding: 9px 20px;
        border-radius: 9px;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.88rem;
    }
</style>

<div class="admin-header">
    <div class="admin-header-icon">👁</div>
    <div>
        <h1>Detalhes do Documento</h1>
        <p>Informações completas do registro</p>
    </div>
</div>

<div class="detalhe-card">
    <div class="detalhe-row">
        <span class="detalhe-label">@Html.DisplayNameFor(m => m.NomeDocumento)</span>
        <span class="detalhe-valor">@Html.DisplayFor(m => m.NomeDocumento)</span>
    </div>
    <div class="detalhe-row">
        <span class="detalhe-label">@Html.DisplayNameFor(m => m.CaminhoDocumento)</span>
        <span class="detalhe-valor">
            <a href="@Model.CaminhoDocumento" target="_blank" style="color:#2563eb">📄 Abrir PDF</a>
        </span>
    </div>
    <div class="detalhe-row">
        <span class="detalhe-label">@Html.DisplayNameFor(m => m.IdCategoria)</span>
        <span class="detalhe-valor">@Html.DisplayFor(m => m.IdCategoria)</span>
    </div>
    <div class="acoes">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-editar">✏️ Editar</a>
        <a asp-action="Index" class="btn-voltar">← Voltar</a>
    </div>
</div>