@model SaudePedraBela.Models.Documento

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Documento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="form-group">
                <label asp-for="NomeDocumento" class="control-label"></label>
                <input asp-for="NomeDocumento" class="form-control" />
            </div>

            <div class="form-group">
                <label>Arquivo PDF</label>
                <input type="file" name="arquivoPdf" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="IdCategoria" class="control-label"></label>
                <select asp-for="IdCategoria" class="form-control" asp-items="ViewBag.IdCategoria"></select>
            </div>

            <br />

            <input type="submit" value="Salvar" class="btn btn-primary" />

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
