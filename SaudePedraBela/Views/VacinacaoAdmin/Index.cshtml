<!-- ===================================================== -->
<!-- PÁGINA: ADMINISTRAÇÃO DE VACINAÇÃO -->
<!-- Esta página funciona como um painel administrativo -->
<!-- para gerenciar campanhas, calendário, locais e PDFs -->
<!-- ===================================================== -->

<h2 class="mb-4">Administração de Vacinação</h2>


<!-- ===================================================== -->
<!-- BOTÕES DE NAVEGAÇÃO ENTRE AS JANELAS -->
<!-- Cada botão chama a função JS "mostrar()" -->
<!-- que exibe apenas a seção selecionada -->
<!-- ===================================================== -->

<div class="mb-4">

    <!-- Abre a seção de campanhas -->
    <button class="btn btn-primary" onclick="mostrar('campanhas')">
        Campanhas
    </button>

    <!-- Abre a seção do calendário vacinal -->
    <button class="btn btn-success" onclick="mostrar('calendario')">
        Calendário Vacinal
    </button>

    <!-- Abre a seção de locais de vacinação -->
    <button class="btn btn-info" onclick="mostrar('locais')">
        Onde se Vacinar
    </button>

    <!-- Abre a seção de documentos PDF -->
    <button class="btn btn-secondary" onclick="mostrar('documentos')">
        Documentos
    </button>

</div>



<!-- ===================================================== -->
<!-- JANELA ADMINISTRATIVA: CAMPANHAS -->
<!-- Exibe todas as campanhas cadastradas no banco -->
<!-- ===================================================== -->

<div id="campanhas" class="janela-admin" style="display:none;">

    <h4>Gerenciar Campanhas</h4>

    <!-- BOTÃO QUE ABRE O MODAL DE CRIAR CAMPANHA -->
    <button class="btn btn-success mb-3"
            data-bs-toggle="modal"
            data-bs-target="#modalCampanha">

        ➕ Criar Campanha

    </button>


    <!-- ===================================================== -->
    <!-- TABELA DE CAMPANHAS -->
    <!-- Cada linha representa uma campanha do banco -->
    <!-- ===================================================== -->

    <table class="table table-striped">

        <thead>
            <tr>
                <th>Título</th>
                <th>Status</th>
                <th>Período</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            <!-- Loop Razor que percorre o Model -->
            @foreach (var c in Model)
            {
                <tr>

                    <!-- Nome da campanha -->
                    <td>@c.Titulo</td>

                    <!-- Status -->
                    <td>@c.Status</td>

                    <!-- Datas -->
                    <td>
                        @c.DataInicio.ToShortDateString()
                        -
                        @c.DataFim.ToShortDateString()
                    </td>

                    <td>

                        <!-- BOTÃO EDITAR -->
                        <!-- Abre modal e envia dados via JS -->
                        <button class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditarCampanha"
                                onclick="editarCampanha(
            '@c.Id',
            '@c.Titulo',
            '@c.DataInicio.ToString("yyyy-MM-dd")',
            '@c.DataFim.ToString("yyyy-MM-dd")',
            '@c.Status',
            '@c.PublicoAlvo',
            '@c.Observacoes'
        )">
                            Editar
                        </button>

                        <!-- BOTÃO EXCLUIR -->
                        <form asp-action="ExcluirCampanha"
                              asp-controller="VacinacaoAdmin"
                              method="post"
                              style="display:inline;">

                            <input type="hidden" name="id" value="@c.Id">

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Excluir
                            </button>

                        </form>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>



<!-- ===================================================== -->
<!-- JANELA ADMINISTRATIVA: CALENDÁRIO VACINAL -->
<!-- Gerencia vacinas por idade -->
<!-- ===================================================== -->

<div id="calendario" class="janela-admin" style="display:none;">

    <h4>Calendário Vacinal Infantil</h4>

    <!-- BOTÃO PARA ADICIONAR LINHA -->
    <button class="btn btn-success mb-3"
            data-bs-toggle="modal"
            data-bs-target="#modalCalendario">

        ➕ Adicionar Linha

    </button>

    <table class="table">

        <thead>
            <tr>
                <th>Idade</th>
                <th>Vacinas</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            <!-- Lista do calendário -->
            @foreach (var item in ViewBag.Calendario)
            {
                <tr>

                    <td>@item.Idade</td>
                    <td>@item.Vacinas</td>

                    <td>

                        <!-- BOTÃO EDITAR -->
                        <button class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditarCalendario"
                                onclick="editarCalendario('@item.Id','@item.Idade','@item.Vacinas')">
                            Editar
                        </button>

                        <form asp-action="ExcluirCalendario"
                              asp-controller="VacinacaoAdmin"
                              method="post"
                              style="display:inline;">

                            <input type="hidden" name="id" value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Deseja excluir este item?')">
                                Excluir
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>



<!-- ===================================================== -->
<!-- JANELA ADMINISTRATIVA: LOCAIS DE VACINAÇÃO -->
<!-- Mostra UBS ou locais de vacinação -->
<!-- ===================================================== -->

<div id="locais" class="janela-admin" style="display:none;">

    <h4>Onde se Vacinar</h4>

    <!-- BOTÃO PARA CRIAR NOVO LOCAL -->
    <button class="btn btn-success mb-3"
            data-bs-toggle="modal"
            data-bs-target="#modalLocal">

        ➕ Novo Local

    </button>

    <table class="table">

        <thead>
            <tr>
                <th>Local</th>
                <th>Horário</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>

            <!-- Lista de locais -->
            @foreach (var local in ViewBag.Locais)
            {
                <tr>

                    <td>@local.Nome</td>
                    <td>@local.Horario</td>

                    <td>

                        <!-- BOTÃO EDITAR -->
                        <button class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditarLocal"
                                onclick="editarLocal('@local.Id','@local.Nome','@local.Horario')">
                            Editar
                        </button>

                        <form asp-action="ExcluirLocal"
                              asp-controller="VacinacaoAdmin"
                              method="post"
                              style="display:inline;">

                            <input type="hidden" name="id" value="@local.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Deseja excluir este local?')">
                                Excluir
                            </button>

                        </form>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<!-- ===================================================== -->
<!-- SEÇÃO ADMINISTRATIVA: DOCUMENTOS -->
<!-- Exibe lista de PDFs cadastrados -->
<!-- ===================================================== -->

<div id="documentos"
     class="janela-admin"
     style="display:none;">

    <h4>
        Documentos de Vacinação
    </h4>

    <button class="btn btn-success mb-3"
            data-bs-toggle="modal"
            data-bs-target="#modalNovoPdf">

        ➕ Adicionar Documento

    </button>

    <table class="table table-bordered">

        <thead>
            <tr>

                <th>
                    Título
                </th>

                <th>
                    Ações
                </th>

            </tr>
        </thead>

        <tbody>

            @if (ViewBag.Documentos != null)
            {
                foreach (var doc in ViewBag.Documentos)
                {

                    <tr>

                        <!-- TÍTULO DO DOCUMENTO -->
                        <td>
                            @doc.Titulo
                        </td>

                        <td>

                            <!-- ABRIR PDF -->
                            <a href="@doc.Caminho"
                               target="_blank"
                               class="btn btn-primary btn-sm">
                                Ver PDF
                            </a>



                            <!-- EXCLUIR DOCUMENTO -->
                            <form asp-action="ExcluirPdfVacina"
                                  asp-controller="VacinacaoAdmin"
                                  method="post"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="nome"
                                       value="@System.IO.Path.GetFileName(doc.Caminho)" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Excluir este documento?')">
                                    Excluir
                                </button>

                            </form>
                        </td>

                    </tr>

                }
            }

        </tbody>

    </table>

</div>



<!-- ===================================================== -->
<!-- SCRIPT JAVASCRIPT -->
<!-- Controla exibição das janelas e preenchimento dos modais -->
<!-- ===================================================== -->

<script>

    // FUNÇÃO QUE MOSTRA UMA JANELA
    function mostrar(id){

        // esconder todas
        document.querySelectorAll(".janela-admin").forEach(j => {
            j.style.display = "none";
        });

        // mostrar selecionada
        document.getElementById(id).style.display = "block";

    }

    // PREENCHE MODAL EDITAR CAMPANHA
    function editarCampanha(id,titulo,inicio,fim,status,publico,obs){

        document.getElementById("editId").value = id;
        document.getElementById("editTitulo").value = titulo;
        document.getElementById("editInicio").value = inicio;
        document.getElementById("editFim").value = fim;
        document.getElementById("editStatus").value = status;
        document.getElementById("editPublico").value = publico;
        document.getElementById("editObs").value = obs;

    }

    // PREENCHE MODAL EDITAR CALENDÁRIO
    function editarCalendario(id,idade,vacinas){

        document.getElementById("editCalId").value = id;
        document.getElementById("editCalIdade").value = idade;
        document.getElementById("editCalVacinas").value = vacinas;

    }

    // PREENCHE MODAL EDITAR LOCAL
    function editarLocal(id,nome,horario){

        document.getElementById("editLocalId").value = id;
        document.getElementById("editLocalNome").value = nome;
        document.getElementById("editLocalHorario").value = horario;

    }

</script>


<!-- ===================================================== -->
<!-- MODAIS DO SISTEMA -->
<!-- Todos os popups utilizados para criar ou editar dados -->
<!-- ===================================================== -->
<!-- ===================================================== -->
<!-- MODAL: CRIAR CAMPANHA -->
<!-- Envia dados para o controller: VacinacaoAdmin -->
<!-- Action: CriarCampanha -->
<!-- ===================================================== -->

<div class="modal fade" id="modalCampanha" tabindex="-1">

    <div class="modal-dialog">
        <div class="modal-content">

            <!-- ======================= -->
            <!-- CABEÇALHO DO MODAL -->
            <!-- ======================= -->

            <div class="modal-header">
                <h5 class="modal-title">Nova Campanha</h5>

                <!-- Botão fechar -->
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>



            <!-- ======================= -->
            <!-- FORMULÁRIO DE CRIAÇÃO -->
            <!-- ======================= -->

            <form asp-action="CriarCampanha"
                  asp-controller="VacinacaoAdmin"
                  method="post">

                <div class="modal-body">

                    <!-- NOME DA CAMPANHA -->
                    <div class="mb-3">
                        <label class="form-label">Nome da campanha</label>

                        <input type="text"
                               name="Titulo"
                               class="form-control"
                               required>
                    </div>



                    <!-- DATA DE INÍCIO -->
                    <div class="mb-3">
                        <label class="form-label">Data início</label>

                        <input type="date"
                               name="DataInicio"
                               class="form-control">
                    </div>



                    <!-- DATA DE FIM -->
                    <div class="mb-3">
                        <label class="form-label">Data fim</label>

                        <input type="date"
                               name="DataFim"
                               class="form-control">
                    </div>



                    <!-- STATUS DA CAMPANHA -->
                    <div class="mb-3">
                        <label class="form-label">Status</label>

                        <select name="Status"
                                class="form-control">

                            <option value="Ativa">Ativa</option>
                            <option value="Inativa">Inativa</option>

                        </select>
                    </div>



                    <!-- PÚBLICO ALVO -->
                    <div class="mb-3">
                        <label class="form-label">Público alvo</label>

                        <input type="text"
                               name="PublicoAlvo"
                               class="form-control"
                               placeholder="Ex: crianças, idosos, gestantes">
                    </div>



                    <!-- OBSERVAÇÕES -->
                    <div class="mb-3">
                        <label class="form-label">Observações</label>

                        <textarea name="Observacoes"
                                  class="form-control"
                                  rows="3">
                        </textarea>
                    </div>

                </div>



                <!-- ======================= -->
                <!-- BOTÕES DO MODAL -->
                <!-- ======================= -->

                <div class="modal-footer">

                    <!-- Cancelar -->
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <!-- Salvar -->
                    <button type="submit"
                            class="btn btn-primary">
                        Salvar
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>



