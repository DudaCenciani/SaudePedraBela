<!-- ===================================================== -->
<!-- MODAL: UPLOAD DE DOCUMENTO PDF -->
<!-- Action: UploadPdfVacina -->
<!-- Permite enviar arquivos PDF para o sistema -->
<!-- ===================================================== -->

<div class="modal fade" id="modalNovoPdf">

    <div class="modal-dialog">
        <div class="modal-content">

            <!-- CABEÇALHO -->
            <div class="modal-header">

                <h5>
                    Novo Documento
                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <!-- FORMULÁRIO -->
            <form asp-action="UploadPdfVacina"
                  asp-controller="VacinacaoAdmin"
                  method="post"
                  enctype="multipart/form-data">

                <div class="modal-body">

                    <!-- TÍTULO DO DOCUMENTO -->
                    <div class="mb-3">

                        <label>
                            Título
                        </label>

                        <input type="text"
                               name="titulo"
                               class="form-control"
                               required>

                    </div>



                    <!-- ARQUIVO PDF -->
                    <div class="mb-3">

                        <label>
                            PDF
                        </label>

                        <input type="file"
                               name="arquivo"
                               accept="application/pdf"
                               class="form-control"
                               required>

                    </div>

                </div>



                <!-- BOTÕES -->
                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Salvar
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>



