@model IEnumerable<CampanhaVacinacao>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Admin - Vacinação";
}

<style>
    .admin-header {
        background: linear-gradient(135deg, #1e7a3a, #2563eb);
        color: white;
        padding: 36px 40px;
        display: flex;
        align-items: center;
        gap: 20px;
        border-radius: 16px;
        margin-bottom: 32px;
    }

    .admin-header-icon {
        background: rgba(255,255,255,0.15);
        border-radius: 14px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 4px;
    }

    .admin-header p {
        margin: 0;
        opacity: 0.85;
    }

    /* Abas de navegação */
    .abas {
        display: flex;
        gap: 8px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .aba-btn {
        padding: 10px 20px;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        background: white;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.2s;
        color: #374151;
    }

        .aba-btn:hover, .aba-btn.ativo {
            background: #1e7a3a;
            color: white;
            border-color: #1e7a3a;
        }

    .secao-card {
        background: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        border: 1.5px solid #e2e8f0;
        margin-bottom: 28px;
        display: none;
    }

        .secao-card.ativo {
            display: block;
        }

        .secao-card h3 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1a2e;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .btn-novo {
        background: #1e7a3a;
        color: white;
        border: none;
        padding: 9px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 20px;
        transition: background 0.2s;
    }

        .btn-novo:hover {
            background: #15612e;
        }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table thead tr {
            background: linear-gradient(90deg, #1e7a3a, #2563eb);
            color: white;
        }

        .admin-table thead th {
            padding: 12px 16px;
            font-size: 0.88rem;
            text-align: left;
        }

        .admin-table tbody tr {
            border-bottom: 1px solid #f1f5f9;
        }

            .admin-table tbody tr:hover {
                background: #f8fafc;
            }

        .admin-table tbody td {
            padding: 12px 16px;
            font-size: 0.88rem;
            color: #374151;
        }

    .btn-editar {
        background: #fef3c7;
        color: #92400e;
        border: none;
        padding: 5px 12px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-del {
        background: #fee2e2;
        color: #dc2626;
        border: none;
        padding: 5px 12px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-ver {
        background: #dbeafe;
        color: #2563eb;
        padding: 5px 12px;
        border-radius: 7px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>


<div class="admin-header">
    <div class="admin-header-icon">💉</div>
    <div>
        <h1>Vacinação</h1>
        <p>Gerencie campanhas, calendário, locais e documentos</p>
    </div>
</div>

<!-- ABAS DE NAVEGAÇÃO -->
<div class="abas">
    <button class="aba-btn ativo" onclick="mostrar('campanhas', this)">💉 Campanhas</button>
    <button class="aba-btn" onclick="mostrar('calendario', this)">📅 Calendário Vacinal</button>
    <button class="aba-btn" onclick="mostrar('locais', this)">📍 Onde se Vacinar</button>
    <button class="aba-btn" onclick="mostrar('documentos', this)">📄 Documentos</button>
</div>


<!-- SEÇÃO: CAMPANHAS -->
<div id="campanhas" class="secao-card ativo">
    <h3>💉 Campanhas de Vacinação</h3>

    <button class="btn-novo" data-bs-toggle="modal" data-bs-target="#modalCampanha">
        ➕ Criar Campanha
    </button>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Status</th>
                <th>Período</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Titulo</td>
                    <td>@c.Status</td>
                    <td>@c.DataInicio.ToShortDateString() - @c.DataFim.ToShortDateString()</td>
                    <td style="display:flex; gap:6px;">
                        <button class="btn-editar"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditarCampanha"
                                onclick="editarCampanha('@c.Id','@c.Titulo','@c.DataInicio.ToString("yyyy-MM-dd")','@c.DataFim.ToString("yyyy-MM-dd")','@c.Status','@c.PublicoAlvo','@c.Observacoes')">
                            ✏️ Editar
                        </button>
                        <form asp-action="ExcluirCampanha" asp-controller="VacinacaoAdmin" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@c.Id">
                            <button type="submit" class="btn-del">🗑 Excluir</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- SEÇÃO: CALENDÁRIO -->
<div id="calendario" class="secao-card">
    <h3>📅 Calendário Vacinal Infantil</h3>

    <button class="btn-novo" data-bs-toggle="modal" data-bs-target="#modalCalendario">
        ➕ Adicionar Linha
    </button>

    <table class="admin-table">
        <thead>
            <tr><th>Idade</th><th>Vacinas</th><th>Ações</th></tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.Calendario)
            {
                <tr>
                    <td>@item.Idade</td>
                    <td>@item.Vacinas</td>
                    <td style="display:flex; gap:6px;">
                        <button class="btn-editar"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditarCalendario"
                                onclick="editarCalendario('@item.Id','@item.Idade','@item.Vacinas')">
                            ✏️ Editar
                        </button>
                        <form asp-action="ExcluirCalendario" asp-controller="VacinacaoAdmin" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn-del" onclick="return confirm('Deseja excluir?')">🗑 Excluir</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- SEÇÃO: LOCAIS -->
<div id="locais" class="secao-card">
    <h3>📍 Onde se Vacinar</h3>

    <button class="btn-novo" data-bs-toggle="modal" data-bs-target="#modalLocal">
        ➕ Novo Local
    </button>

    <table class="admin-table">
        <thead>
            <tr><th>Local</th><th>Horário</th><th>Ações</th></tr>
        </thead>
        <tbody>
            @foreach (var local in ViewBag.Locais)
            {
                <tr>
                    <td>@local.Nome</td>
                    <td>@local.Horario</td>
                    <td style="display:flex; gap:6px;">
                        <button class="btn-editar"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEditarLocal"
                                onclick="editarLocal('@local.Id','@local.Nome','@local.Horario')">
                            ✏️ Editar
                        </button>
                        <form asp-action="ExcluirLocal" asp-controller="VacinacaoAdmin" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@local.Id" />
                            <button type="submit" class="btn-del" onclick="return confirm('Deseja excluir?')">🗑 Excluir</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- SEÇÃO: DOCUMENTOS -->
<div id="documentos" class="secao-card">
    <h3>📄 Documentos de Vacinação</h3>

    <button class="btn-novo" data-bs-toggle="modal" data-bs-target="#modalNovoPdf">
        ➕ Adicionar Documento
    </button>

    <table class="admin-table">
        <thead>
            <tr><th>Título</th><th>Ações</th></tr>
        </thead>
        <tbody>
            @if (ViewBag.Documentos != null)
            {
                foreach (var doc in ViewBag.Documentos)
                {
                    <tr>
                        <td>@doc.Titulo</td>
                        <td style="display:flex; gap:6px;">
                            <a href="@doc.Caminho" target="_blank" class="btn-ver">👁 Ver PDF</a>
                            <form asp-action="ExcluirPdfVacina" asp-controller="VacinacaoAdmin" method="post" style="display:inline;">
                                <input type="hidden" name="nome" value="@System.IO.Path.GetFileName(doc.Caminho)" />
                                <button type="submit" class="btn-del" onclick="return confirm('Excluir?')">🗑 Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


<!-- ===== TODOS OS MODAIS ===== -->
<!-- Modal Nova Campanha -->
<div class="modal fade" id="modalCampanha" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">💉 Nova Campanha</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="CriarCampanha" asp-controller="VacinacaoAdmin" method="post">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Nome</label><input type="text" name="Titulo" class="form-control" required></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Data início</label><input type="date" name="DataInicio" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Data fim</label><input type="date" name="DataFim" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Status</label><select name="Status" class="form-control"><option value="Em andamento">Em andamento</option><option value="Disponível">Disponível</option><option value="Encerrada">Encerrada</option></select></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Público-alvo</label><input type="text" name="PublicoAlvo" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Observações</label><textarea name="Observacoes" class="form-control" rows="3"></textarea></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Campanha -->
<div class="modal fade" id="modalEditarCampanha" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">✏️ Editar Campanha</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="EditarCampanha" asp-controller="VacinacaoAdmin" method="post">
                <input type="hidden" name="Id" id="editId">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Nome</label><input type="text" name="Titulo" id="editTitulo" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Data início</label><input type="date" name="DataInicio" id="editInicio" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Data fim</label><input type="date" name="DataFim" id="editFim" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Status</label><select name="Status" id="editStatus" class="form-control"><option value="Em andamento">Em andamento</option><option value="Disponível">Disponível</option><option value="Encerrada">Encerrada</option></select></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Público-alvo</label><input type="text" name="PublicoAlvo" id="editPublico" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Observações</label><textarea name="Observacoes" id="editObs" class="form-control"></textarea></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Novo Calendário -->
<div class="modal fade" id="modalCalendario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">📅 Nova Linha</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="CriarCalendario" asp-controller="VacinacaoAdmin" method="post">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Idade</label><input type="text" name="Idade" class="form-control" placeholder="Ex: 2 meses"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Vacinas</label><input type="text" name="Vacinas" class="form-control" placeholder="Ex: Pentavalente, VIP"></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Calendário -->
<div class="modal fade" id="modalEditarCalendario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">✏️ Editar Calendário</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="EditarCalendario" asp-controller="VacinacaoAdmin" method="post">
                <input type="hidden" id="editCalId" name="Id">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Idade</label><input type="text" id="editCalIdade" name="Idade" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Vacinas</label><input type="text" id="editCalVacinas" name="Vacinas" class="form-control"></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Novo Local -->
<div class="modal fade" id="modalLocal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">📍 Novo Local</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="CriarLocal" asp-controller="VacinacaoAdmin" method="post">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Nome</label><input type="text" name="Nome" class="form-control" placeholder="Ex: UBS Central"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Horário</label><input type="text" name="Horario" class="form-control" placeholder="Ex: Seg a Sex 8h às 16h"></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Local -->
<div class="modal fade" id="modalEditarLocal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">✏️ Editar Local</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="EditarLocal" asp-controller="VacinacaoAdmin" method="post">
                <input type="hidden" id="editLocalId" name="Id">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Nome</label><input type="text" id="editLocalNome" name="Nome" class="form-control"></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Horário</label><input type="text" id="editLocalHorario" name="Horario" class="form-control"></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Novo PDF -->
<div class="modal fade" id="modalNovoPdf">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0"><h5 class="fw-bold">📄 Novo Documento</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <form asp-action="UploadPdfVacina" asp-controller="VacinacaoAdmin" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label fw-semibold">Título</label><input type="text" name="titulo" class="form-control" required></div>
                    <div class="mb-3"><label class="form-label fw-semibold">PDF</label><input type="file" name="arquivo" accept="application/pdf" class="form-control" required></div>
                </div>
                <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success">Salvar</button></div>
            </form>
        </div>
    </div>
</div>


<script>
    // Alterna entre as seções e marca a aba como ativa
    function mostrar(id, btn) {
        document.querySelectorAll(".secao-card").forEach(s => s.classList.remove("ativo"));
        document.querySelectorAll(".aba-btn").forEach(b => b.classList.remove("ativo"));
        document.getElementById(id).classList.add("ativo");
        if (btn) btn.classList.add("ativo");
    }

    function editarCampanha(id, titulo, inicio, fim, status, publico, obs) {
        document.getElementById("editId").value = id;
        document.getElementById("editTitulo").value = titulo;
        document.getElementById("editInicio").value = inicio;
        document.getElementById("editFim").value = fim;
        document.getElementById("editStatus").value = status;
        document.getElementById("editPublico").value = publico;
        document.getElementById("editObs").value = obs;
    }

    function editarCalendario(id, idade, vacinas) {
        document.getElementById("editCalId").value = id;
        document.getElementById("editCalIdade").value = idade;
        document.getElementById("editCalVacinas").value = vacinas;
    }

    function editarLocal(id, nome, horario) {
        document.getElementById("editLocalId").value = id;
        document.getElementById("editLocalNome").value = nome;
        document.getElementById("editLocalHorario").value = horario;
    }
</script>